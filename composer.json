{
    "name": "wedeto/http",
    "license": "MIT",
    "description": "Wedeto Platform - HTTP requests, responses, sessions and cookies",
    "homepage": "https://wedeto.net",
    "type": "library",
    "require": {
        "wedeto/util": "^1.1.1",
        "wedeto/io": "^1.1.0",
        "wedeto/fileformats": "^1.1.0",
        "php": "^7.4 || >=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33",
        "phpspec/prophecy-phpunit": "^2.0",
        "mikey179/vfsstream": "^1.6",
        "wedeto/log": "^1.1.0",
        "wedeto/db": "^1.1.0"
    },
    "suggest": {
        "ext-xdebug": "Enables code coverage"
    },
    "autoload": {
        "psr-4": {
            "Wedeto\\HTTP\\": "src/"
        }
    },
    "archive": {
        "exclude": ["/tests","/phpunit.xml"]
    },
    "authors": [
        {
            "name": "Egbert van der Wal",
            "email": "ewal@pointpro.nl"
        }
    ]
}
